using System.Collections.Generic;
using UnityEngine;

public static class SVC_IA_EquipeSpecialisationService
{
    private static List<SCOBJ_EQUIPE_SPECIALISATION> cacheSpecialisations;

    public static void TenterSpecialisationEquipes(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || joueur.equipes == null)
            return;

        List<SCOBJ_EQUIPE_SPECIALISATION> specialisations = ChargerSpecialisationsDisponibles();
        if (specialisations == null || specialisations.Count == 0)
            return;

        foreach (STATE_EQUIPE equipe in joueur.equipes)
        {
            if (equipe == null || equipe.AUneActionEnCours)
                continue;

            SCOBJ_EQUIPE_SPECIALISATION cible = ChoisirSpecialisationPourIA(
                gameManager,
                joueur,
                equipe,
                specialisations
            );

            if (cible == null)
                continue;

            bool succes = SVC_EQUIPE_SpecialisationService.AppliquerSpecialisation(equipe, cible);

            Debug.Log(
                $"[IA_SPECIALISATION] joueur={joueur.nomJoueur} | " +
                $"equipe={equipe.data?.nomEquipe} | specialisation={cible.nomAffiche} | succes={succes}"
            );
        }
    }

    private static List<SCOBJ_EQUIPE_SPECIALISATION> ChargerSpecialisationsDisponibles()
    {
        if (cacheSpecialisations != null && cacheSpecialisations.Count > 0)
            return cacheSpecialisations;

        SCOBJ_EQUIPE_SPECIALISATION[] assets =
            Resources.FindObjectsOfTypeAll<SCOBJ_EQUIPE_SPECIALISATION>();

        cacheSpecialisations = new List<SCOBJ_EQUIPE_SPECIALISATION>();

        if (assets == null || assets.Length == 0)
            return cacheSpecialisations;

        HashSet<ENUM_EQUIPE_SPECIALISATION> typesAjoutes = new();

        foreach (SCOBJ_EQUIPE_SPECIALISATION asset in assets)
        {
            if (asset == null)
                continue;

            if (typesAjoutes.Contains(asset.type))
                continue;

            typesAjoutes.Add(asset.type);
            cacheSpecialisations.Add(asset);
        }

        return cacheSpecialisations;
    }

    private static SCOBJ_EQUIPE_SPECIALISATION ChoisirSpecialisationPourIA(
        SYS_GameManager gameManager,
        DATA_JOUEUR joueur,
        STATE_EQUIPE equipe,
        List<SCOBJ_EQUIPE_SPECIALISATION> specialisations)
    {
        if (joueur == null || equipe == null || specialisations == null || specialisations.Count == 0)
            return null;

        List<SCOBJ_EQUIPE_SPECIALISATION> choixDisponibles =
            SVC_EQUIPE_SpecialisationService.GetChoixDisponibles(equipe, specialisations);

        if (choixDisponibles == null || choixDisponibles.Count == 0)
            return null;

        if (equipe.specialisation == ENUM_EQUIPE_SPECIALISATION.Reconnaissance)
            return ChoisirSpecialisationPalier1(gameManager, joueur, choixDisponibles);

        SCOBJ_EQUIPE_SPECIALISATION meilleurChoix = null;
        float meilleurScore = float.MinValue;

        foreach (SCOBJ_EQUIPE_SPECIALISATION specialisation in choixDisponibles)
        {
            if (specialisation == null)
                continue;

            float score = EvaluerSpecialisationPourIA(gameManager, joueur, equipe, specialisation);

            Debug.Log(
                $"[IA_SPECIALISATION_SCORE] joueur={joueur.nomJoueur} | " +
                $"equipe={equipe.data?.nomEquipe} | candidat={specialisation.type} | score={score:0.##}"
            );

            if (score > meilleurScore)
            {
                meilleurScore = score;
                meilleurChoix = specialisation;
            }
        }

        return meilleurChoix;
    }

    private static SCOBJ_EQUIPE_SPECIALISATION ChoisirSpecialisationPalier1(
        SYS_GameManager gameManager,
        DATA_JOUEUR joueur,
        List<SCOBJ_EQUIPE_SPECIALISATION> choixDisponibles)
    {
        if (joueur == null || choixDisponibles == null || choixDisponibles.Count == 0)
            return null;

        SCOBJ_EQUIPE_SPECIALISATION choixExploration = null;
        SCOBJ_EQUIPE_SPECIALISATION choixMiliciens = null;
        SCOBJ_EQUIPE_SPECIALISATION choixConstruction = null;

        foreach (SCOBJ_EQUIPE_SPECIALISATION choix in choixDisponibles)
        {
            if (choix == null)
                continue;

            switch (choix.type)
            {
                case ENUM_EQUIPE_SPECIALISATION.Exploration:
                    choixExploration = choix;
                    break;
                case ENUM_EQUIPE_SPECIALISATION.Miliciens:
                    choixMiliciens = choix;
                    break;
                case ENUM_EQUIPE_SPECIALISATION.Construction:
                    choixConstruction = choix;
                    break;
            }
        }

        int nbExploration = SVC_IA_EquipeCompositionService.CompterEquipesExploration(joueur);
        int nbMiliciens = SVC_IA_EquipeCompositionService.CompterEquipesMiliciennes(joueur);
        int nbConstruction = SVC_IA_EquipeCompositionService.CompterEquipesConstruction(joueur);

        float pressionVadrouille = EvaluerPressionVadrouille(gameManager, joueur);
        float pressionExploration = EvaluerPressionExploration(gameManager, joueur);

        // On veut toujours au moins 1 explo pour ouvrir la carte.
        if (nbExploration == 0 && choixExploration != null)
            return choixExploration;

        // Très important :
        // si l'IA a des provinces prêtes à être occupées et aucune branche milicienne,
        // on curiosite Miliciens.
        if (choixMiliciens != null && nbMiliciens == 0 && pressionVadrouille >= 80f)
            return choixMiliciens;

        // Si l'IA a déjà assez d'exploration mais manque de miliciens, on pousse Miliciens.
        if (choixMiliciens != null && nbMiliciens < nbExploration && pressionVadrouille > pressionExploration * 0.6f)
            return choixMiliciens;

        ENUM_EQUIPE_SPECIALISATION branchePrioritaire =
            SVC_IA_EquipeCompositionService.GetBrancheLaPlusManquante(joueur);

        switch (branchePrioritaire)
        {
            case ENUM_EQUIPE_SPECIALISATION.Miliciens:
                if (choixMiliciens != null) return choixMiliciens;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Construction:
                if (choixConstruction != null) return choixConstruction;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Exploration:
            default:
                if (choixExploration != null) return choixExploration;
                break;
        }

        // Dernier filet : si la pression de conquête est déjà forte, privilégier miliciens.
        if (choixMiliciens != null && pressionVadrouille > pressionExploration)
            return choixMiliciens;

        if (choixExploration != null) return choixExploration;
        if (choixMiliciens != null) return choixMiliciens;
        if (choixConstruction != null) return choixConstruction;

        return null;
    }

    private static float EvaluerSpecialisationPourIA(
        SYS_GameManager gameManager,
        DATA_JOUEUR joueur,
        STATE_EQUIPE equipe,
        SCOBJ_EQUIPE_SPECIALISATION specialisation)
    {
        if (joueur == null || equipe == null || specialisation == null)
            return float.MinValue;

        float score = 0f;

        float pressionExploration = EvaluerPressionExploration(gameManager, joueur);
        float pressionVadrouille = EvaluerPressionVadrouille(gameManager, joueur);

        int nbExploration = SVC_IA_EquipeCompositionService.CompterEquipesExploration(joueur);
        int nbMiliciens = SVC_IA_EquipeCompositionService.CompterEquipesMiliciennes(joueur);
        int nbConstruction = SVC_IA_EquipeCompositionService.CompterEquipesConstruction(joueur);

        switch (specialisation.type)
        {
            case ENUM_EQUIPE_SPECIALISATION.Archeologues:
                score += 35f;
                score += pressionExploration * 0.25f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Arpenteurs:
                score += 45f;
                score += pressionExploration * 0.35f;

                // Si on a déjà trop d'exploration par rapport aux miliciens, on pénalise.
                if (nbExploration > nbMiliciens + 1)
                    score -= 80f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.GardienDeLaPaix:
                score += 50f;
                score += pressionVadrouille * 0.45f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Intervention:
                score += 60f;
                score += pressionVadrouille * 0.55f;

                if (joueur.profilIA != null &&
                    joueur.profilIA.type == ENUM_IA_Personnalite.Agressive)
                {
                    score += 40f;
                }
                break;

            case ENUM_EQUIPE_SPECIALISATION.Colons:
            case ENUM_EQUIPE_SPECIALISATION.GenieCivil:
                score += 25f;
                if (nbConstruction == 0)
                    score += 20f;
                break;
        }

        score += SVC_IA_PersonnaliteResolver.GetBonusSpecialisation(joueur, specialisation.type);
        score += Random.Range(0f, 5f);

        return score;
    }

    private static float EvaluerPressionExploration(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return 0f;

        float score = 0f;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);

            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (claimParIA)
                continue;

            if (exploration < 100f)
            {
                score += (100f - exploration) * 1.2f;
                score += province.data.prestige * 0.8f;
                score += province.data.poidsPolitique * 0.6f;
            }
        }

        return score;
    }

    private static float EvaluerPressionVadrouille(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return 0f;

        float score = 0f;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);
            if (exploration < 100f)
                continue;

            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (claimParIA)
                continue;

            float influenceAdverse = GetInfluenceAdverseDominante(province, joueur.compagnie);
            float influenceIA = GetInfluenceCompagnie(province, joueur.compagnie);

            // Vadrouille = moyen direct de convertir l’exploration en contrôle réel.
            score += influenceAdverse * 3.5f;

            if (!province.estClaim)
                score += 60f;

            if (province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value != joueur.compagnie)
            {
                score += 90f;
            }

            if (influenceIA > 0f && influenceIA < 60f)
                score += 35f;

            score += province.data.prestige * 0.5f;
            score += province.data.poidsPolitique * 0.8f;
        }

        return score;
    }

    private static float GetInfluenceAdverseDominante(STATE_PROVINCE province, ENUM_Compagnie compagnie)
    {
        if (province == null)
            return 0f;

        float maizin = compagnie == ENUM_Compagnie.Maizin ? 0f : province.influenceMaizin;
        float kinia = compagnie == ENUM_Compagnie.Kinia ? 0f : province.influenceKinia;
        float joho = compagnie == ENUM_Compagnie.Joho ? 0f : province.influenceJoho;

        return Mathf.Max(maizin, Mathf.Max(kinia, joho));
    }

    private static float GetInfluenceCompagnie(STATE_PROVINCE province, ENUM_Compagnie compagnie)
    {
        if (province == null)
            return 0f;

        switch (compagnie)
        {
            case ENUM_Compagnie.Maizin:
                return province.influenceMaizin;
            case ENUM_Compagnie.Kinia:
                return province.influenceKinia;
            case ENUM_Compagnie.Joho:
                return province.influenceJoho;
            default:
                return 0f;
        }
    }
}