using System.Collections.Generic;
using UnityEngine;

public static class SVC_IA_EquipeSpecialisationService
{
    private static List<SCOBJ_EQUIPE_SPECIALISATION> cacheSpecialisations;

    public static void TenterSpecialisationEquipes(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || joueur.equipes == null)
            return;

        List<SCOBJ_EQUIPE_SPECIALISATION> specialisations = ChargerSpecialisationsDisponibles();

        if (specialisations == null || specialisations.Count == 0)
        {
            Debug.LogWarning("[IA_SPECIALISATION] Aucune spécialisation trouvée dans le projet.");
            return;
        }

        foreach (STATE_EQUIPE equipe in joueur.equipes)
        {
            if (equipe == null)
                continue;

            if (equipe.AUneActionEnCours)
                continue;

            SCOBJ_EQUIPE_SPECIALISATION cible = ChoisirSpecialisationPourIA(
                gameManager,
                joueur,
                equipe,
                specialisations
            );

            if (cible == null)
                continue;

            ENUM_EQUIPE_SPECIALISATION avant = equipe.specialisation;
            bool succes = SVC_EQUIPE_SpecialisationService.AppliquerSpecialisation(equipe, cible);

            Debug.Log(
                $"[IA_SPECIALISATION_APPLY] joueur={joueur.nomJoueur} | " +
                $"equipe={equipe.data?.nomEquipe} | avant={avant} | cible={cible.type} | succes={succes}"
            );
        }
    }

    private static List<SCOBJ_EQUIPE_SPECIALISATION> ChargerSpecialisationsDisponibles()
    {
        if (cacheSpecialisations != null && cacheSpecialisations.Count > 0)
            return cacheSpecialisations;

        SCOBJ_EQUIPE_SPECIALISATION[] assets =
            Resources.FindObjectsOfTypeAll<SCOBJ_EQUIPE_SPECIALISATION>();

        cacheSpecialisations = new List<SCOBJ_EQUIPE_SPECIALISATION>();

        if (assets == null || assets.Length == 0)
            return cacheSpecialisations;

        HashSet<ENUM_EQUIPE_SPECIALISATION> typesAjoutes = new();

        foreach (SCOBJ_EQUIPE_SPECIALISATION asset in assets)
        {
            if (asset == null)
                continue;

            if (typesAjoutes.Contains(asset.type))
                continue;

            typesAjoutes.Add(asset.type);
            cacheSpecialisations.Add(asset);
        }

        return cacheSpecialisations;
    }

    private static SCOBJ_EQUIPE_SPECIALISATION ChoisirSpecialisationPourIA(
        SYS_GameManager gameManager,
        DATA_JOUEUR joueur,
        STATE_EQUIPE equipe,
        List<SCOBJ_EQUIPE_SPECIALISATION> specialisations)
    {
        if (joueur == null || equipe == null || specialisations == null || specialisations.Count == 0)
            return null;

        List<SCOBJ_EQUIPE_SPECIALISATION> choixDisponibles =
            SVC_EQUIPE_SpecialisationService.GetChoixDisponibles(equipe, specialisations);

        if (choixDisponibles == null || choixDisponibles.Count == 0)
            return null;

        SCOBJ_EQUIPE_SPECIALISATION meilleurChoix = null;
        float meilleurScore = float.MinValue;

        foreach (SCOBJ_EQUIPE_SPECIALISATION specialisation in choixDisponibles)
        {
            if (specialisation == null)
                continue;

            float score = EvaluerSpecialisationPourIA(gameManager, joueur, equipe, specialisation);

            if (score > meilleurScore)
            {
                meilleurScore = score;
                meilleurChoix = specialisation;
            }
        }

        return meilleurChoix;
    }

    private static float EvaluerSpecialisationPourIA(
        SYS_GameManager gameManager,
        DATA_JOUEUR joueur,
        STATE_EQUIPE equipe,
        SCOBJ_EQUIPE_SPECIALISATION specialisation)
    {
        if (joueur == null || equipe == null || specialisation == null)
            return float.MinValue;

        float score = 0f;
        STATE_PROVINCE province = equipe.provinceAffectee;

        float explorationLocale = 0f;
        float influenceAdverseLocale = 0f;
        float etriniumLocal = 0f;
        float prestigeLocal = 0f;

        if (province != null && province.data != null)
        {
            explorationLocale = province.GetExploration(joueur.compagnie);
            etriniumLocal = province.data.etrinium;
            prestigeLocal = province.data.prestige;
            influenceAdverseLocale = GetInfluenceAdverseDominante(province, joueur.compagnie);
        }

        bool aCibleExploration = ExisteCibleExploration(gameManager, joueur);
        bool aCibleVadrouille = ExisteCibleVadrouille(gameManager, joueur);

        float scoreExplorationGlobal = EvaluerBesoinExplorationGlobal(gameManager, joueur);
        float scoreVadrouilleGlobal = EvaluerBesoinVadrouilleGlobal(gameManager, joueur);

        switch (specialisation.type)
        {
            case ENUM_EQUIPE_SPECIALISATION.Exploration:
                score += scoreExplorationGlobal * 1.2f;
                score += (100f - explorationLocale) * 2.0f;
                score += etriniumLocal * 1.0f;
                score += prestigeLocal * 0.9f;
                if (!aCibleExploration)
                    score -= 120f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Archeologues:
                score += scoreExplorationGlobal * 0.8f;
                score += prestigeLocal * 2.5f;
                score += etriniumLocal * 0.6f;
                if (!aCibleExploration)
                    score -= 100f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Arpenteurs:
                score += scoreExplorationGlobal * 1.5f;
                score += (100f - explorationLocale) * 3.0f;
                score += etriniumLocal * 0.8f;
                if (!aCibleExploration)
                    score -= 140f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Miliciens:
                score += scoreVadrouilleGlobal * 1.8f;
                score += influenceAdverseLocale * 2.0f;
                if (aCibleVadrouille)
                    score += 220f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.GardienDeLaPaix:
                score += scoreVadrouilleGlobal * 1.5f;
                score += influenceAdverseLocale * 1.6f;
                if (aCibleVadrouille)
                    score += 180f;
                score += 20f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Intervention:
                score += scoreVadrouilleGlobal * 2.0f;
                score += influenceAdverseLocale * 2.4f;
                if (aCibleVadrouille)
                    score += 200f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Construction:
                score += 20f;
                break;

            case ENUM_EQUIPE_SPECIALISATION.Colons:
            case ENUM_EQUIPE_SPECIALISATION.GenieCivil:
                score += 10f;
                break;
        }

        score += SVC_IA_PersonnaliteResolver.GetBonusSpecialisation(joueur, specialisation.type);
        score += Random.Range(0f, 5f);

        return score;
    }

    private static bool ExisteCibleExploration(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return false;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);
            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (exploration < 100f && !claimParIA)
                return true;
        }

        return false;
    }

    private static bool ExisteCibleVadrouille(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return false;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);
            if (exploration < 100f)
                continue;

            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (claimParIA)
                continue;

            float influenceAdverse = GetInfluenceAdverseDominante(province, joueur.compagnie);
            float influenceIA = GetInfluenceCompagnie(province, joueur.compagnie);

            if (influenceAdverse > 0.01f || (influenceIA > 0f && influenceIA < 60f) || !province.estClaim)
                return true;
        }

        return false;
    }

    private static float EvaluerBesoinExplorationGlobal(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return 0f;

        float score = 0f;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);
            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (claimParIA)
                continue;

            if (exploration < 100f)
                score += 100f - exploration;
        }

        return score;
    }

    private static float EvaluerBesoinVadrouilleGlobal(SYS_GameManager gameManager, DATA_JOUEUR joueur)
    {
        if (gameManager == null || joueur == null || gameManager.ProvincesRuntime == null)
            return 0f;

        float score = 0f;

        foreach (STATE_PROVINCE province in gameManager.ProvincesRuntime)
        {
            if (province == null || province.data == null)
                continue;

            float exploration = province.GetExploration(joueur.compagnie);
            if (exploration < 100f)
                continue;

            bool claimParIA =
                province.estClaim &&
                province.proprietaireActuel.HasValue &&
                province.proprietaireActuel.Value == joueur.compagnie;

            if (claimParIA)
                continue;

            float influenceAdverse = GetInfluenceAdverseDominante(province, joueur.compagnie);
            float influenceIA = GetInfluenceCompagnie(province, joueur.compagnie);

            score += influenceAdverse * 2f;

            if (!province.estClaim)
                score += 40f;

            if (influenceIA > 0f && influenceIA < 60f)
                score += 20f;
        }

        return score;
    }

    private static float GetInfluenceAdverseDominante(STATE_PROVINCE province, ENUM_Compagnie compagnie)
    {
        if (province == null)
            return 0f;

        float maizin = compagnie == ENUM_Compagnie.Maizin ? 0f : province.influenceMaizin;
        float kinia = compagnie == ENUM_Compagnie.Kinia ? 0f : province.influenceKinia;
        float joho = compagnie == ENUM_Compagnie.Joho ? 0f : province.influenceJoho;

        return Mathf.Max(maizin, Mathf.Max(kinia, joho));
    }

    private static float GetInfluenceCompagnie(STATE_PROVINCE province, ENUM_Compagnie compagnie)
    {
        if (province == null)
            return 0f;

        switch (compagnie)
        {
            case ENUM_Compagnie.Maizin:
                return province.influenceMaizin;
            case ENUM_Compagnie.Kinia:
                return province.influenceKinia;
            case ENUM_Compagnie.Joho:
                return province.influenceJoho;
            default:
                return 0f;
        }
    }
}